# Copier ce fichier en .env (ou .env.local, prioritaire) puis adapter les valeurs.
# Toutes les variables sont validées au démarrage par src/env.ts.

# --- Application ------------------------------------------------------------
APP_NAME=movie-backend-hono
# development | production
NODE_ENV=development
PORT=3000

# --- Base de données -------------------------------------------------------
# postgres:// ou postgresql://user:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:15432/movie-db-hono

# --- CORS ------------------------------------------------------------------
# Origines autorisées à appeler l'API, séparées par des virgules (ex. le front Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Utilisateur courant simulé (pas encore d'authentification) -------------
# Crée un utilisateur via POST /auth/register, puis reporte son id ici.
DEV_USER_ID=00000000-0000-4000-8000-000000000000
DEV_USERNAME=john.doe@example.com

# --- Catalogue de films externe ---------------------------------------------
EXTERNAL_MOVIE_API_BASE_URL=https://nodejs-develop-5290.up.railway.app
# Clé fournie par l'enseignant
EXTERNAL_MOVIE_API_KEY=changeme
